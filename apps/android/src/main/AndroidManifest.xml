<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        网络状态是「切网自动重连」的前提：没有这条权限时
        ConnectivityManager.registerDefaultNetworkCallback 会直接抛 SecurityException
        （被 runCatching 吞掉），表现就是 WiFi→移动数据后完全没有回调，
        群晖一直连不上，必须重启 App。ACCESS_NETWORK_STATE 是普通权限，安装即授予。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!--
        文件管理器的核心功能之一：点开 APK 交系统安装器安装。Android 8+ 起必须
        声明这条权限，否则系统安装器会以「没有安装权限」拒绝，并把用户踢到
        设置页自己找「安装未知应用」入口——这正是 1.0.1 引入的回归，1.0.0 一直有。
        声明不等于静默安装：MIUI 等 ROM 首次仍要用户在系统设置里点一次授权，
        但那是系统安装器的正常引导，不是应用被拒装。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        流式播放（外部播放器 + 本机代理）需要 mediaPlayback 类型的前台服务：
        没有它，播放器接管屏幕后本应用退到后台会被 ROM 掐断网络（MIUI 实测），
        视频播十几秒就 Source error。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
        Android 11+ 的包可见性限制：不加 <queries> 时 queryIntentActivities 只能看到
        很少几个系统应用，导致「打开方式」里已安装的音乐 / 视频 App 全部消失。
        这里声明本应用需要查询「能处理 ACTION_VIEW / SEND 的应用」。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <!--
            「打开方式」里要排除浏览器：判定方式是查「谁能处理 https」。
            只声明上面的 mimeType 条目时，带 scheme 的 data 查询同样受包可见性限制，
            于是只查得到系统默认浏览器，Via / 夸克这类全都漏网（真机实测）。
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!--
        不用 Android 13+ 的预测式返回：Compose 的 BackHandler 与部分 ROM
        （MIUI 等）在页面刚切换的那一小段时间里会漏掉预测式返回手势，
        表现是「左边缘滑不出返回，换右边滑一次之后才恢复」。
        关掉后所有返回统一走传统 onBackPressed 回调，左右边缘手势都稳定生效。
    -->
    <application
        android:name=".MyFileBoxApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="false"
        tools:ignore="UnusedAttribute"
        android:theme="@style/Theme.MyFileBox">
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver
            android:name=".TransferCancelReceiver"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!--
            冷启动时 ContentProvider 阶段（Application.onCreate 之前）会跑完所有
            androidx.startup 的 initializer。实测这一段占冷启动总时长约 1/3：
              · EmojiCompatInitializer：初始化 emoji 字体加载，Compose 用不到；
              · WorkManagerInitializer：打开 Room 数据库并重排任务，首帧用不到，
                改由 Application 实现 Configuration.Provider 惰性初始化。
            两者移出启动路径后，首次真正用到时再按需初始化，行为不变。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
        <!--
            启动入口改由 activity-alias 提供：MainActivity 自身不再挂 LAUNCHER。
            「应用图标跟随主题色」只需在 alias 之间切换，targetActivity 永远
            保持 enabled——禁用它的话部分 ROM 连 alias 也起不来。
            默认启用 IconOriginal，图标与加这个功能之前完全一致。
            注意：升级后启动组件名会变，部分桌面会重排图标 / 使旧快捷方式失效。
            MainActivity 自身不接收外部 intent，exported=false；外部启动一律走
            上面的 alias（alias 保持 exported=true，否则桌面无法拉起）。
